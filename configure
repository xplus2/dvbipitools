#!/bin/sh
# Copyright 2026 dvbipitools authors. Licensed under GPL-3.0-or-later.
# See NOTICE and LICENSE for details and authorship information.

set -eu

BUILD_TYPE=Debug
BUILD_LINK=dynamic
CC=${CC:-cc}
SANITIZE=no
TSAN=no
TESTS=no
FUZZING=no
TLS=auto
CSA=yes
RIST=auto
SRT=auto
ZLIB=auto
HTTP2=auto
HTTP3=auto

usage() {
    cat <<EOF
usage: ./configure [options]
  --debug        debug build (default)
  --release      optimized build, binaries stripped
  --static       link statically
  --sanitize     build with AddressSanitizer + UndefinedBehaviorSanitizer
  --tsan         build with ThreadSanitizer (cannot combine with --sanitize)
  --tests        enable 'make test' target
  --fuzz         enable 'make fuzz-harnesses' target (AFL++ standalone harnesses;
                 pass --cc=afl-clang-fast for real instrumentation)
  --no-tls       build dipirec, dipiradiohead, dipitvhead without HTTPS/TLS
                 support
  --no-csa       build dipitvhead, dipiradiohead, dipidescramble w/o CSA1/CSA2/BISS1
  --no-rist      skip dipirist (default: auto-detect librist)
  --no-srt       skip dipisrt (default: auto-detect libsrt)
  --no-zlib      build dipibcg without BCG container compression support
  --no-http2     build dipixy without HTTP/2 support (default: auto-detect
                 libnghttp2)
  --no-http3     build dipixy without HTTP/3 support (default: auto-detect
                 libngtcp2/libnghttp3)
  --cc=CC        C compiler (default: cc, or \$CC)
  -h, --help     this help
EOF
}

while [ $# -gt 0 ]; do
    case "$1" in
        --debug)    BUILD_TYPE=Debug ;;
        --release)  BUILD_TYPE=Release ;;
        --static)   BUILD_LINK=static ;;
        --sanitize) SANITIZE=yes ;;
        --tsan)     TSAN=yes ;;
        --tests)    TESTS=yes ;;
        --fuzz)     FUZZING=yes ;;
        --no-tls)   TLS=no ;;
        --no-csa)   CSA=no ;;
        --no-rist)  RIST=no ;;
        --no-srt)   SRT=no ;;
        --no-zlib)  ZLIB=no ;;
        --no-http2) HTTP2=no ;;
        --no-http3) HTTP3=no ;;
        --cc=*)     CC=${1#--cc=} ;;
        -h|--help)  usage; exit 0 ;;
        *) echo "configure: unknown option: $1" >&2; usage >&2; exit 1 ;;
    esac
    shift
done

if [ "$SANITIZE" = yes ] && [ "$BUILD_LINK" = static ]; then
    echo "configure: --sanitize and --static cannot be combined" >&2
    exit 1
fi

if [ "$TSAN" = yes ] && [ "$BUILD_LINK" = static ]; then
    echo "configure: --tsan and --static cannot be combined" >&2
    exit 1
fi

if [ "$SANITIZE" = yes ] && [ "$TSAN" = yes ]; then
    echo "configure: --sanitize and --tsan cannot be combined" >&2
    exit 1
fi

BUILD_ARCH=$(uname -m)

CFLAGS="-std=gnu11 -Wall -Wextra -Werror -Isrc"
CFLAGS="$CFLAGS -DBUILD_ARCH=\\\"$BUILD_ARCH\\\""
CFLAGS="$CFLAGS -DBUILD_TYPE=\\\"$BUILD_TYPE\\\""
CFLAGS="$CFLAGS -DBUILD_LINK=\\\"$BUILD_LINK\\\""
if [ "$BUILD_TYPE" = Release ]; then
    CFLAGS="$CFLAGS -O2 -DNDEBUG"
else
    CFLAGS="$CFLAGS -g -O0"
fi

LDFLAGS=""
[ "$BUILD_LINK" = static ] && LDFLAGS="$LDFLAGS -static"
[ "$BUILD_TYPE" = Release ] && LDFLAGS="$LDFLAGS -s"

if [ "$SANITIZE" = yes ]; then
    CFLAGS="$CFLAGS -fsanitize=address,undefined -fno-omit-frame-pointer"
    LDFLAGS="$LDFLAGS -fsanitize=address,undefined"
fi

if [ "$TSAN" = yes ]; then
    CFLAGS="$CFLAGS -fsanitize=thread -fno-omit-frame-pointer"
    LDFLAGS="$LDFLAGS -fsanitize=thread"
fi

CHECK_CFLAGS=""
CHECK_LIBS=""
if [ "$TESTS" = yes ]; then
    if ! pkg-config --exists check; then
        echo "configure: --tests requires Check (pkg-config module 'check') which was not found" >&2
        exit 1
    fi
    CHECK_CFLAGS=$(pkg-config --cflags check)
    CHECK_LIBS=$(pkg-config --libs check)
fi

cat > config.mk <<EOF
# generated - do not edit
CC := $CC
CFLAGS := $CFLAGS
LDFLAGS :=$LDFLAGS
TESTS := $TESTS
CHECK_CFLAGS := $CHECK_CFLAGS
CHECK_LIBS := $CHECK_LIBS
FUZZING := $FUZZING
TSAN := $TSAN
TLS := $TLS
CSA := $CSA
RIST := $RIST
SRT := $SRT
ZLIB := $ZLIB
HTTP2 := $HTTP2
HTTP3 := $HTTP3
EOF

echo "configured: $BUILD_TYPE $BUILD_LINK $BUILD_ARCH (CC=$CC) sanitize=$SANITIZE tsan=$TSAN tests=$TESTS fuzz=$FUZZING tls=$TLS csa=$CSA rist=$RIST srt=$SRT zlib=$ZLIB http2=$HTTP2 http3=$HTTP3"
echo "run 'make' to build."
