[Unit]
Description=dipimetrics
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=dvbipitools
RuntimeDirectory=dvbipitools
# change the arguments to your needs before actually using the service
ExecStart=/usr/bin/dipimetrics \
    --sock /run/dvbipitools/metrics.sock --listen 127.0.0.1:9109
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target