[Unit]
Description=dipiradiohead_mux01
After=network-online.target dipimetrics.service
Wants=network-online.target dipimetrics.service
PartOf=dipimetrics.service
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
# example: change the arguments to your needs before actually using the service
ExecStart=/usr/bin/dipiradiohead -e 5 \
  -i https://example.com/radiostation.m3u \
  -m 239.1.1.1:5000 -r -s "Best Hits Ever Radio" --provider "dvbipitools" \
  --metrics-id radiohead_mux01 --metrics /run/dvbipitools/metrics.sock
Restart=on-failure
RestartSec=5
User=dvbipitools
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
# metrics socket, drop together with --metrics-id
ReadWritePaths=/run/dvbipitools

[Install]
WantedBy=multi-user.target