[Unit]
Description=dipirist
After=network-online.target dipimetrics.service
Wants=network-online.target dipimetrics.service
PartOf=dipimetrics.service
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
# example: change the arguments to your needs before actually using the service
ExecStart=/usr/bin/dipirist \
  -i rtp://@239.1.1.1:5000 -o rist://1.2.3.4:6000 --buffer 1000 \
  --metrics-id rist --metrics /run/dvbipitools/metrics.sock
Restart=on-failure
RestartSec=5
# needs to be the same as dipimetrics for metrics
User=dvbipitools
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# metrics socket, drop together with --metrics-id
ReadWritePaths=/run/dvbipitools

[Install]
WantedBy=multi-user.target
