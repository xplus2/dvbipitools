
[Unit]
Description=dipifccret
After=network-online.target dipimetrics.service
Wants=network-online.target dipimetrics.service
PartOf=dipimetrics.service
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
# change the arguments to your needs before actually using the service
ExecStart=/usr/bin/dipifccret \
    -g 239.19.0.0/16 -l 10.0.0.1:6000 -I eth0 \
    --metrics-id fccret --metrics /run/dvbipitools/metrics.sock
Restart=on-failure
RestartSec=5
# needs to be the same as dipimetrics for metrics
User=dvbipitools
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
LimitNOFILE=65536
# metrics socket, drop together with --metrics-id
ReadWritePaths=/run/dvbipitools

[Install]
WantedBy=multi-user.target