[Unit]
Description=dipicam378
After=network-online.target dipimetrics.service
Wants=network-online.target dipimetrics.service
PartOf=dipimetrics.service
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
# example: change the arguments to your needs before actually using the service
ExecStart=/usr/bin/dipicam378 \
  -k ${CREDENTIALS_DIRECTORY}/device.key \
  -s cardserial-01 \
  -a someuser:somepassword \
  --metrics-id cam378-01 --metrics /run/dvbipitools/metrics.sock
# key stays root-only, exposed via credentials dir
LoadCredential=device.key:/etc/dvbipitools/dipicam378/device.key
Restart=on-failure
RestartSec=5
# needs to be the same as dipimetrics for metrics
User=dvbipitools
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# metrics socket, drop together with --metrics-id
ReadWritePaths=/run/dvbipitools

[Install]
WantedBy=multi-user.target
